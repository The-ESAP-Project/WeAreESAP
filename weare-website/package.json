  },
  "bugs": {
    "url": "https://github.com/The-ESAP-Project/WeAreESAP/issues"
  },
  "scripts": {
    "dev": "pnpm run prebuild && next dev",
    "prebuild": "node ./scripts/generate-blur-placeholders.mjs && node ./scripts/generate-build-info.mjs",
    "build": "next build",
    "postbuild": "next-sitemap --config ./scripts/next-sitemap.config.js",
    "start": "next start",
    "analyze": "pnpm build --webpack",
    "test": "pnpm run build && vitest run && playwright test",
    "test:unit": "pnpm prebuild build && vitest",
    "test:unit:run": "pnpm prebuild prebuild && vitest run",
    "test:unit:ui": "pnpm run prebuild && vitest --ui",
    "test:unit:coverage": "pnpm run prebuild && vitest run --coverage",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:ui": "pnpm run build && playwright test --ui",
    "test:e2e:debug": "pnpm run build && playwright test --debug",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "license:add": "node ./scripts/add-license-headers.js",
    "blur:generate": "node ./scripts/generate-blur-placeholders.mjs",
    "sitemap:generate": "next-sitemap --config ./scripts/next-sitemap.config.js"
  },
  "dependencies": {
    "@esap/shared-ui": "workspace:*",
    "@tanstack/react-virtual": "3.14.12",
    "elkjs": "^0.11.1",
    "framer-motion": "12.43.0",
    "fuse.js": "^7.5.0",
    "next": "16.3.5",
    "next-intl": "^4.14.4",
    "next-themes": "^0.4.6",
    "pangu": "^7.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "reactflow": "^11.11.4",
    "styled-jsx": "^5.1.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "baseline-browser-mapping": "^2.11.22",
    "jsdom": "29.1.1",
    "next-sitemap": "^4.2.3",
    "plaiceholder": "^3.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
